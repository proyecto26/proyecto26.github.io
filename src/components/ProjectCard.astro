---
/**
 * Project card with a proximity glow border.
 * Must be rendered inside a `.glow-grid` container so the global pointer
 * script in BaseLayout can feed it the pointer position.
 * The whole card is one link (stretched ::after) with the GitHub link layered above it.
 */
interface Props {
  title: string;
  subtitle?: string;
  description: string;
  icon?: string;
  iconColor?: 'coral' | 'teal' | 'orange' | 'blue';
  tags: string[];
  stars?: number;
  forks?: number;
  href: string;
  githubUrl?: string;
  index?: number;
}

const {
  title,
  subtitle,
  description,
  icon,
  iconColor = 'coral',
  tags,
  stars,
  forks,
  href,
  githubUrl,
  index,
} = Astro.props;

const glow = {
  coral: ['#f2385a', '#f5a503'],
  teal: ['#4ad9d9', '#36b1bf'],
  orange: ['#f5a503', '#f2385a'],
  blue: ['#36b1bf', '#4ad9d9'],
}[iconColor];

const dot = {
  coral: 'bg-accent-coral',
  teal: 'bg-accent-teal',
  orange: 'bg-accent-orange',
  blue: 'bg-accent-blue',
}[iconColor];

const formatNumber = (num: number) =>
  num >= 1000 ? (num / 1000).toFixed(1).replace(/\.0$/, '') + 'k' : num.toString();
---

<article
  class="glow-card group flex flex-col h-full p-6 md:p-7"
  style={`--glow-a:${glow[0]};--glow-b:${glow[1]}`}
>
  <header class="flex items-start justify-between gap-4 mb-8">
    <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.14em] text-text-muted">
      {icon ? (
        <img src={icon} alt="" loading="lazy" width="20" height="20" class="w-5 h-5 object-contain" />
      ) : (
        <span class={`w-2 h-2 rounded-full ${dot}`} aria-hidden="true"></span>
      )}
      {subtitle}
    </div>
    {index !== undefined && (
      <span class="font-mono text-xs text-text-muted tabular-nums" aria-hidden="true">
        {String(index + 1).padStart(2, '0')}
      </span>
    )}
  </header>

  <h3 class="font-display text-2xl font-semibold tracking-tight text-text-primary mb-3 break-words">
    <a href={href} target="_blank" rel="noopener noreferrer" class="card-link focus-visible:outline-none">
      {title}
    </a>
  </h3>

  <p class="text-text-secondary text-[0.9375rem] leading-relaxed mb-6 line-clamp-3">
    {description}
  </p>

  <ul class="flex flex-wrap gap-1.5 mb-6" aria-label="Technologies">
    {tags.slice(0, 3).map((tag) => (
      <li class="px-2.5 py-1 text-xs text-text-muted border border-border-default rounded-full">
        {tag}
      </li>
    ))}
  </ul>

  <footer class="mt-auto pt-5 border-t border-border-default flex items-center justify-between gap-4 text-sm">
    <div class="flex items-center gap-4 font-mono text-text-muted tabular-nums">
      {stars !== undefined && (
        <span class="flex items-center gap-1.5" title={`${stars} GitHub stars`}>
          <i data-lucide="star" class="w-3.5 h-3.5 text-stars-gold" aria-hidden="true"></i>
          <span class="sr-only">Stars:</span>{formatNumber(stars)}
        </span>
      )}
      {forks !== undefined && (
        <span class="flex items-center gap-1.5" title={`${forks} forks`}>
          <i data-lucide="git-fork" class="w-3.5 h-3.5" aria-hidden="true"></i>
          <span class="sr-only">Forks:</span>{formatNumber(forks)}
        </span>
      )}
    </div>

    <div class="relative z-[2] flex items-center gap-3">
      {githubUrl && href !== githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-text-primary transition-colors"
          aria-label={`${title} on GitHub`}
        >
          <i data-lucide="github" class="w-4 h-4" aria-hidden="true"></i>
        </a>
      )}
      <i
        data-lucide="arrow-up-right"
        class="w-4 h-4 text-text-muted transition-[color,translate] duration-300 group-hover:text-text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        aria-hidden="true"
      ></i>
    </div>
  </footer>
</article>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Stretch the title link across the card; focus ring drawn on the card */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    z-index: 1;
  }

  .glow-card:has(.card-link:focus-visible) {
    outline: 2px solid var(--color-accent-coral);
    outline-offset: 3px;
  }
</style>
