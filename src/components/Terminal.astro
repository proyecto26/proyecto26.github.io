---
/**
 * Agent-session mock used by the AI showcase. Purely presentational:
 * the session is illustrative, so it is labelled as such for every user.
 * If a `video` (e.g. a HyperFrames-rendered MP4) is provided it replaces the transcript.
 */
import type { ShowcaseDemo } from '../data/projects';

interface Props {
  title: string;
  demo: ShowcaseDemo;
  video?: string;
  class?: string;
}

const { title, demo, video, class: className = '' } = Astro.props;
---

<figure class={`terminal ${className}`}>
  <div class="terminal-bar">
    <span class="flex gap-1.5" aria-hidden="true">
      <i class="w-2.5 h-2.5 rounded-full bg-[#3a3530]"></i>
      <i class="w-2.5 h-2.5 rounded-full bg-[#3a3530]"></i>
      <i class="w-2.5 h-2.5 rounded-full bg-[#3a3530]"></i>
    </span>
    <span class="truncate">{title}</span>
    <span class="ml-auto text-[0.625rem] tracking-[0.14em] uppercase">Illustrative</span>
  </div>

  {video ? (
    <video class="w-full aspect-video object-cover" src={video} muted loop playsinline autoplay preload="none" aria-label={`${title} demo video`}></video>
  ) : (
    <div class="terminal-body">
      <p class="terminal-line" style="--i:0">
        <span class="text-accent-coral" aria-hidden="true">❯</span>
        <span class="text-text-primary">{demo.prompt}</span>
      </p>
      {demo.lines.map((line, i) => (
        <p
          class:list={[
            'terminal-line',
            line.tone === 'ok' && 'text-accent-teal',
            line.tone === 'accent' && 'text-accent-orange',
            (!line.tone || line.tone === 'muted') && 'text-text-muted',
          ]}
          style={`--i:${i + 1}`}
        >
          {line.text}
        </p>
      ))}
      <p class="terminal-line terminal-caret" style={`--i:${demo.lines.length + 1}`} aria-hidden="true">
        <span class="text-accent-coral">❯</span><span class="caret"></span>
      </p>
    </div>
  )}
  <figcaption class="sr-only">Example agent session for {title}</figcaption>
</figure>

<style>
  .terminal {
    max-inline-size: 100%;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-xl);
    background: #0f0e0c;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 30px 80px -30px rgb(0 0 0 / 0.8);
    font-family: var(--font-mono);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .terminal-body {
    padding: 1.25rem 1.25rem 1.5rem;
    font-size: 0.8125rem;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .terminal-line {
    display: flex;
    gap: 0.625rem;
    white-space: pre-wrap;
  }

  .caret {
    display: inline-block;
    inline-size: 0.55em;
    block-size: 1.1em;
    translate: 0 0.2em;
    background: var(--color-text-secondary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }

    /* Lines "type in" when the parent panel becomes active */
    :global([data-panel]) .terminal-line {
      opacity: 0;
      translate: 0 0.35rem;
      transition: opacity 0.35s ease, translate 0.35s ease;
      transition-delay: calc(var(--i) * 140ms + 120ms);
    }

    :global([data-panel][data-active]) .terminal-line {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }
</style>
