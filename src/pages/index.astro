---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AIShowcase from '../components/AIShowcase.astro';
import GameCard from '../components/GameCard.astro';
import Button from '../components/Button.astro';
import { getFeaturedProjects, getAIProjects } from '../data/projects';
import { getOrgContributors, getOrgTotalStars } from '../utils/github';
import { getSponsorsGrouped, sponsorPlatforms } from '../data/sponsors';

// Fetch featured projects with GitHub stats at build time
const projects = await getFeaturedProjects(9);
const aiProjects = await getAIProjects();
const totalStars = await getOrgTotalStars('proyecto26');
const starsDisplay = totalStars > 0 ? `${totalStars.toLocaleString('en-US')}+` : '4,500+';

// Fetch top contributors at build time
const contributors = await getOrgContributors('proyecto26', 20);

// Get sponsor tiers with real sponsor data (fetched at build time)
const sponsorTiers = await getSponsorsGrouped();
const homepageTiers = sponsorTiers
  .sort((a, b) => b.minAmount - a.minAmount);

// Gold and Platinum sponsors for the logo display section
const featuredSponsors = sponsorTiers
  .filter((t) => t.name === 'Gold Sponsor' || t.name === 'Platinum Partner')
  .flatMap((t) => t.sponsors);

const games = [
  {
    title: 'NinjaDev',
    description: 'A side-scrolling platformer that showcases advanced game development techniques. Jump, run, and slash your way through challenging levels.',
    tags: ['Phaser', '2D Platformer', 'Action'],
    href: '/games/ninjadev',
    featured: true,
  },
  {
    title: 'The Crypto Purge',
    description: 'Action-packed crypto-themed game adventure.',
    tags: ['Phaser', 'Web3', 'WebSockets'],
    href: 'https://devpost.com/software/the-crypto-purge-jamg3s',
  },
  {
    title: 'PokéDex GO',
    description: 'Community of Pokemon masters, hybrid mobile app created to showcase real-time interactions with Firebase.',
    tags: ['Cordova/Ionic', 'Firebase'],
    href: 'https://github.com/proyecto26/PokeDex-GO',
  },
];

const supportLinks = sponsorPlatforms.filter((p) => !p.primary).slice(0, 4);
---

<BaseLayout title="Proyecto 26 - Changing the world with small contributions" description="Open source tools for web, mobile, games and AI agents. Claude Code plugins, Unity and React Native libraries, and browser games, built in the open since 2014.">
  <Header currentPage="home" />

  <main id="main-content">
    <Hero stars={starsDisplay} aiCount={aiProjects.length} />

    <!-- 01 · AI Lab -->
    <section id="ai-lab" class="section relative scroll-mt-16" aria-labelledby="ai-lab-title">
      <div class="container">
        <SectionHeader
          id="ai-lab-title"
          index="01"
          eyebrow="AI Lab"
          title="Agents that <em class='not-italic text-accent-coral'>ship</em>, not demos."
          lede="Plugins and skills for Claude Code, Codex, OpenClaw and friends. Each one is open source, installs with one command and runs on your machine."
        >
          <a href="/projects#ai" class="inline-flex items-center gap-2 text-sm text-text-secondary hover:text-text-primary transition-colors">
            All AI projects <i data-lucide="arrow-right" class="w-4 h-4" aria-hidden="true"></i>
          </a>
        </SectionHeader>

        <AIShowcase projects={aiProjects} />
      </div>
    </section>

    <!-- 02 · Open source tools -->
    <section id="projects" class="section bg-bg-secondary border-y border-border-subtle" aria-labelledby="projects-title">
      <div class="container">
        <SectionHeader
          id="projects-title"
          index="02"
          eyebrow="Open source"
          title="Tools developers have trusted for a decade."
          lede="In-app browsers for React Native and NativeScript, a promise-based REST client for Unity, web components and curated lists with thousands of stars."
        >
          <Button href="/projects" variant="secondary">
            Browse all projects
            <i data-lucide="arrow-right" class="w-4 h-4" aria-hidden="true"></i>
          </Button>
        </SectionHeader>

        <ul class="glow-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" role="list">
          {projects.map((project, index) => (
            <li data-reveal style={`--stagger:${index % 3}`}>
              <ProjectCard {...project} index={index} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 03 · Games -->
    <section class="section" aria-labelledby="games-title">
      <div class="container">
        <SectionHeader
          id="games-title"
          index="03"
          eyebrow="Playground"
          title="Where it all started: games."
          lede="Phaser, Unity and Ionic experiments that became the libraries above. Grab a keyboard."
        >
          <Button href="/games" variant="secondary">
            <i data-lucide="gamepad-2" class="w-4 h-4" aria-hidden="true"></i>
            All games
          </Button>
        </SectionHeader>

        <div class="mb-6" data-reveal>
          <GameCard {...games[0]} />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {games.slice(1).map((game, index) => (
            <div data-reveal style={`--stagger:${index % 2}`}>
              <GameCard {...game} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 · Founder -->
    <section id="about" class="section bg-bg-secondary border-y border-border-subtle" aria-labelledby="founder-title">
      <div class="container">
        <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-5" data-reveal>
            <div class="relative max-w-sm">
              <div class="rounded-3xl" data-parallax-frame>
              <img
                src="/img/jdnichollsc.jpg"
                alt="Juan David Nicholls, founder of Proyecto 26"
                width="384"
                height="384"
                loading="lazy"
                class="w-full aspect-square object-cover rounded-3xl grayscale-[35%] contrast-[1.05]"
              />
              </div>
              <div data-parallax style="--speed:-28px" class="absolute -bottom-4 -right-4 px-4 py-2 rounded-full bg-accent-coral text-[#0c0b0a] font-mono text-xs uppercase tracking-[0.14em]">
                14+ years
              </div>
            </div>
          </div>

          <div class="lg:col-span-7" data-reveal>
            <p class="eyebrow mb-6"><span class="text-accent-coral">04</span> Founder</p>
            <p class="display-lg text-text-primary mb-8">
              Built by one developer.<br /><span class="text-text-muted">Sustained by a community.</span>
            </p>
            <h2 id="founder-title" class="text-xl font-semibold text-text-primary">Juan David Nicholls</h2>
            <p class="text-text-muted mb-6">Founder &amp; Lead Developer</p>
            <p class="text-text-secondary max-w-[60ch] mb-8">
              Full-stack developer and open source contributor with over 14 years in web, mobile, game,
              blockchain and cloud development. Speaker, mentor and, lately, builder of AI agents.
            </p>

            <ul class="flex items-center gap-2" role="list">
              {[
                { href: 'https://linkedin.com/in/jdnichollsc', icon: 'linkedin', label: 'LinkedIn' },
                { href: 'https://github.com/jdnichollsc', icon: 'github', label: 'GitHub' },
                { href: 'https://x.com/jdnichollsc', icon: 'twitter', label: 'X (Twitter)' },
                { href: 'https://youtube.com/@proyecto26', icon: 'youtube', label: 'YouTube' },
              ].map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.label}
                    class="w-11 h-11 rounded-full border border-border-default flex items-center justify-center text-text-secondary hover:text-text-primary hover:border-border-accent transition-colors"
                  >
                    <i data-lucide={s.icon} class="w-5 h-5" aria-hidden="true"></i>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 · Community -->
    <section class="section" aria-labelledby="community-title">
      <div class="container">
        <SectionHeader
          id="community-title"
          index="05"
          eyebrow="Community"
          title="Small contributions, from a lot of people."
        />

        <div class="grid gap-12 lg:grid-cols-2">
          {contributors.length > 0 && (
            <div data-reveal>
              <h3 class="font-mono text-xs uppercase tracking-[0.14em] text-text-muted mb-6">Contributors</h3>
              <ul class="flex flex-wrap gap-2 mb-8" role="list">
                {contributors.map((contributor) => (
                  <li>
                    <a
                      href={contributor.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block rounded-full"
                      title={`@${contributor.username} (${contributor.contributions} contributions)`}
                    >
                      <img
                        src={`${contributor.avatar}&s=96`}
                        alt={`@${contributor.username}`}
                        width="48"
                        height="48"
                        loading="lazy"
                        class="w-12 h-12 rounded-full ring-1 ring-border-default transition duration-200 hover:ring-accent-coral hover:scale-110 motion-reduce:hover:scale-100"
                      />
                    </a>
                  </li>
                ))}
              </ul>
              <Button href="https://github.com/proyecto26" variant="secondary" size="sm" external>
                Become a contributor
                <i data-lucide="arrow-up-right" class="w-4 h-4" aria-hidden="true"></i>
              </Button>
            </div>
          )}

          <div data-reveal>
            <h3 class="font-mono text-xs uppercase tracking-[0.14em] text-text-muted mb-6">Backed by</h3>
            {featuredSponsors.length > 0 ? (
              <ul class="flex flex-wrap items-center gap-8" role="list">
                {featuredSponsors.map((sponsor) => (
                  <li>
                    <a
                      href={sponsor.url || '/sponsors'}
                      target={sponsor.url ? '_blank' : undefined}
                      rel={sponsor.url ? 'noopener noreferrer' : undefined}
                      class="flex items-center grayscale hover:grayscale-0 opacity-80 hover:opacity-100 transition"
                      title={sponsor.name}
                    >
                      {sponsor.image ? (
                        <img src={sponsor.image} alt={sponsor.name} width="64" height="64" loading="lazy" class="h-14 w-auto max-w-[160px] object-contain rounded-lg" />
                      ) : (
                        <span class="text-lg font-semibold text-text-secondary">{sponsor.name}</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <a href="/sponsors" class="inline-block px-6 py-4 border border-dashed border-border-default rounded-2xl text-text-muted hover:text-text-primary hover:border-border-accent transition-colors">
                Your logo here: become a Gold or Platinum sponsor
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- 06 · Sponsor -->
    <section id="contact" class="section bg-bg-secondary border-t border-border-subtle" aria-labelledby="sponsor-title">
      <div class="container">
        <SectionHeader
          id="sponsor-title"
          index="06"
          eyebrow="Sponsor"
          title="Keep the tools free. Keep them shipping."
          lede="Thousands of developers already use our tools. Your sponsorship, no matter how small, funds maintenance, new plugins and monthly development updates."
        >
          <Button href="/sponsors" variant="primary">
            All tiers &amp; sponsors
            <i data-lucide="arrow-right" class="w-4 h-4" aria-hidden="true"></i>
          </Button>
        </SectionHeader>

        <ul class="glow-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-14" role="list">
          {homepageTiers.map((tier) => (
            <li data-reveal>
              <div class:list={['glow-card h-full p-6 flex flex-col', tier.featured && '!border-border-accent']}>
                <div class="flex items-center justify-between mb-6">
                  <i data-lucide={tier.icon} class={`w-5 h-5 text-accent-${tier.color}`} aria-hidden="true"></i>
                  {tier.featured && (
                    <span class="px-2.5 py-0.5 rounded-full bg-accent-coral text-[#0c0b0a] text-xs font-semibold">Popular</span>
                  )}
                </div>
                <h3 class="text-lg font-semibold text-text-primary">{tier.name}</h3>
                {tier.audience && <p class="text-text-muted text-xs mb-3">{tier.audience}</p>}
                <p class="flex items-baseline gap-1 mb-3">
                  <span class="font-display text-4xl font-semibold tracking-tight text-text-primary">{tier.price}</span>
                  <span class="text-text-muted text-sm">{tier.period}</span>
                </p>
                <p class="text-text-secondary text-sm mb-5">{tier.description}</p>
                <ul class="space-y-2 mb-6" role="list">
                  {tier.benefits.map((benefit) => (
                    <li class="flex items-start gap-2 text-sm text-text-secondary">
                      <i data-lucide="check" class="w-4 h-4 text-accent-teal mt-0.5 flex-shrink-0" aria-hidden="true"></i>
                      {benefit}
                    </li>
                  ))}
                </ul>
                <div class="mt-auto relative z-[2]">
                  <Button href="https://github.com/sponsors/proyecto26" variant={tier.featured ? 'primary' : 'secondary'} size="sm" external>
                    Sponsor as {tier.name}
                  </Button>
                </div>
              </div>
            </li>
          ))}
        </ul>

        <div class="flex flex-wrap items-center gap-3" data-reveal>
          <span class="font-mono text-xs uppercase tracking-[0.14em] text-text-muted mr-2">Also on</span>
          {supportLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-4 py-2 rounded-full border border-border-default text-sm text-text-secondary hover:text-text-primary hover:border-border-accent transition-colors"
            >
              <i data-lucide={link.icon} class="w-4 h-4" style={`color: ${link.color};`} aria-hidden="true"></i>
              {link.name}
            </a>
          ))}
          <Button href="https://github.com/proyecto26" variant="ghost" size="sm" external>
            <i data-lucide="star" class="w-4 h-4" aria-hidden="true"></i>
            Star us on GitHub
          </Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
